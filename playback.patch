+/* A score tap cues the downbeat inside the current chorus. */
+EXPORT(jbw_seek) void jbw_seek(int bar) {
+    jb_t *e = E();
+    if (e->state == ST_STOP || bar < 0 || bar >= e->nbars) return;
+    for (int i = 0; i < JB_VOICES; i++) e->v[i].active = 0;
+    for (int i = 0; i < NLV; i++) LV[i].on = 0;
+    e->state = e->s_state = ST_PLAY;
+    e->bar = e->s_bar = bar;
+    e->tick = e->s_beat = 0;
+    e->acc = e->spt;
+    e->kind = BK_CHART;
+    e->jump = -1;
+    e->ending = e->tag_i = e->pv_ok = e->skip_down = e->crash_next = e->gv = 0;
+    make_bar(e, &e->vb, bar, BK_CHART, e->shift, 0);
+    plan_next(e);
